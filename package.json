{
  "name": "eksiazeczka-zdrowia",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "patient-pwa",
    "doctor-app",
    "server",
    "data"
  ],
  "scripts": {
    "dev": "concurrently -k -n pwa,doctor,server -c blue,green,magenta \"npm run dev -w patient-pwa\" \"npm run dev -w doctor-app\" \"npm run dev -w server\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w server",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.4.2",
    "puppeteer-core": "^23.11.1",
    "typescript": "~5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
